<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\Sdk.props" />

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.1.0</Version>

    <PackageId>Okta.AuthFoundation</PackageId>
    <Title>Okta AuthFoundation for .NET</Title>
    <Description>Foundational OAuth2/OIDC types for the Okta .NET SDK: HTTP client, token and credential management, JWT and JWK validation, and encrypted local token storage.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.14.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="Ace4896.DBus.Services.Secrets" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Okta.OAuth2" />
    <InternalsVisibleTo Include="Okta.Client.Sdk.Tests" />
  </ItemGroup>

</Project>
