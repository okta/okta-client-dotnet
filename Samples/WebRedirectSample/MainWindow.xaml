<Window x:Class="Okta.Client.Sdk.Samples.WebRedirect.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Authorization Code Flow Sample" Height="500" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Configuration Panel -->
        <StackPanel Grid.Row="0" Margin="10">
            <TextBlock Text="OAuth2 Configuration" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
            
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Issuer URL:" VerticalAlignment="Center" Margin="0,5"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="IssuerTextBox" Margin="5" 
                         Text="https://your-domain.okta.com/oauth2/default"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Client ID:" VerticalAlignment="Center" Margin="0,5"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="ClientIdTextBox" Margin="5"
                         Text="your-client-id"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Redirect URI:" VerticalAlignment="Center" Margin="0,5"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="RedirectUriTextBox" Margin="5"
                         Text="http://localhost:8080/callback" IsReadOnly="True"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Scopes:" VerticalAlignment="Center" Margin="0,5"/>
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="ScopesTextBox" Margin="5"
                         Text="openid profile email offline_access"/>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="StartAuthButton" Content="Login" Width="100" 
                        Click="StartAuthButton_Click"/>
                <Button x:Name="LogoutButton" Content="Logout" Width="100" Margin="10,0,0,0"
                        Click="LogoutButton_Click" IsEnabled="False"/>
                <Button x:Name="CancelButton" Content="Cancel" Width="80" Margin="10,0,0,0"
                        Click="CancelButton_Click" IsEnabled="False"/>
            </StackPanel>

            <TextBlock Text="Token Management" FontWeight="Bold" FontSize="14" Margin="0,15,0,5"/>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="StoreCredentialButton" Content="Store Credential" Width="120"
                        Click="StoreCredentialButton_Click" IsEnabled="False"/>
                <Button x:Name="RefreshTokenButton" Content="Refresh Token" Width="110" Margin="10,0,0,0"
                        Click="RefreshTokenButton_Click" IsEnabled="False"/>
                <Button x:Name="RevokeTokenButton" Content="Revoke Token" Width="110" Margin="10,0,0,0"
                        Click="RevokeTokenButton_Click" IsEnabled="False"/>
                <Button x:Name="RemoveCredentialButton" Content="Remove Credential" Width="130" Margin="10,0,0,0"
                        Click="RemoveCredentialButton_Click" IsEnabled="False"/>
                <Button x:Name="UserInfoButton" Content="User Info" Width="90" Margin="10,0,0,0"
                        Click="UserInfoButton_Click" IsEnabled="False"/>
                <Button x:Name="ListCredentialsButton" Content="List Credentials" Width="120" Margin="10,0,0,0"
                        Click="ListCredentialsButton_Click"/>
                <Button x:Name="LoadDefaultButton" Content="Load Default" Width="100" Margin="10,0,0,0"
                        Click="LoadDefaultButton_Click"/>
                <Button x:Name="ClearAllButton" Content="Clear All" Width="80" Margin="10,0,0,0"
                        Click="ClearAllButton_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- Results Panel -->
        <DockPanel Grid.Row="1" Margin="10">
            <TextBlock DockPanel.Dock="Top" Text="Results" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
            <TextBox x:Name="ResultsTextBox" IsReadOnly="True" 
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="11"
                     AcceptsReturn="True"/>
        </DockPanel>
    </Grid>
</Window>
