<Project>

  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- SA0001: no XML doc generation required; SA1101: `this.` not required in modern C#;
         SA1200: using directives outside namespace is standard; SA1309: _fieldName is idiomatic .NET;
         SA1636: copyright text matching is bugged in this version — SA1633 enforces header existence instead;
         SA1201/SA1202: element/access ordering — too invasive to enforce on existing code, teams vary;
         SA1402: multiple types per file — common helper/test pattern;
         SA1649: file name must match type — would require file renames;
         CA1848: LoggerMessage delegates — performance-only, not correctness -->
    <NoWarn>$(NoWarn);SA0001;SA1101;SA1200;SA1309;SA1636;SA1201;SA1202;SA1402;SA1649;CA1848;CA1716</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.507">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)stylecop.json" Link="stylecop.json" />
  </ItemGroup>

</Project>
